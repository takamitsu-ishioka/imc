# Copy this file to .env in the same directory, then edit it by hand and
# run: chmod 600 .env
#
# This file is the only place where credentials live. Neither the generated
# mbsync config nor the notmuch config contains a password; mbsync reads it
# through PassCmd at run time.

# --- Who you are (notmuch uses this to recognise mail addressed to you) ---
IMC_USER_NAME="Taro Nippon"
IMC_USER_PRIMARY_EMAIL="you@example.com"
# Space separated extra addresses of yours, or "" if none.
IMC_USER_OTHER_EMAILS="you@gmail.example.com"

# --- Accounts ---
# Space separated account names. Each name must match [a-z0-9_]+ because it
# becomes part of a shell variable name and of a Maildir directory name.
# Start with one account; add more later and re-run initialize.sh.
#
# Every account needs PROTOCOL set to IMAP or POP3.
#   IMAP -> synced by mbsync. Needs HOST/PORT/USER/PASSWORD/TLSTYPE, and
#           optionally CERTIFICATEFILE.
#   POP3 -> synced by getmail (mbsync cannot speak POP3 at all). Needs
#           HOST/PORT/USER/PASSWORD, and optionally CERTIFICATEFILE. Always
#           POP3-over-SSL; there is no plaintext POP3 option. Mail is never
#           deleted from the server (same policy as IMAP accounts).
IMC_ACCOUNTS="selfhosted"

IMC_ACCOUNT_selfhosted_PROTOCOL="IMAP"
IMC_ACCOUNT_selfhosted_HOST="mail.example.com"
IMC_ACCOUNT_selfhosted_PORT="993"
IMC_ACCOUNT_selfhosted_USER="you@example.com"
IMC_ACCOUNT_selfhosted_PASSWORD="replace-with-the-imap-password"
# IMAPS (implicit TLS, usually port 993) or STARTTLS (usually port 143).
IMC_ACCOUNT_selfhosted_TLSTYPE="IMAPS"
# Path to a CA or self-signed certificate file, or "" to use the system store.
IMC_ACCOUNT_selfhosted_CERTIFICATEFILE=""

# --- Example of a second account (Gmail with an app password, IMAP) ---
# Add "gmail" to IMC_ACCOUNTS above, then uncomment and fill these in.
#IMC_ACCOUNT_gmail_PROTOCOL="IMAP"
#IMC_ACCOUNT_gmail_HOST="imap.gmail.com"
#IMC_ACCOUNT_gmail_PORT="993"
#IMC_ACCOUNT_gmail_USER="you@gmail.example.com"
#IMC_ACCOUNT_gmail_PASSWORD="replace-with-a-16-character-app-password"
#IMC_ACCOUNT_gmail_TLSTYPE="IMAPS"
#IMC_ACCOUNT_gmail_CERTIFICATEFILE=""

# --- Example of a POP3-only account (some ISPs never offer IMAP) ---
# Add "oldisp" to IMC_ACCOUNTS above, then uncomment and fill these in.
# No TLSTYPE here: POP3 accounts are always POP3-over-SSL.
#IMC_ACCOUNT_oldisp_PROTOCOL="POP3"
#IMC_ACCOUNT_oldisp_HOST="pop.your-isp.example"
#IMC_ACCOUNT_oldisp_PORT="995"
#IMC_ACCOUNT_oldisp_USER="your-login-name"
#IMC_ACCOUNT_oldisp_PASSWORD="replace-with-the-pop3-password"
#IMC_ACCOUNT_oldisp_CERTIFICATEFILE=""

# --- Morning push notification ---
# This topic is separate from the one in ~/bin/ntfy/.env on purpose: a work
# completion notice and a morning mail digest must not share a channel.
#
# On the public ntfy.sh server the topic name IS the password: anyone who
# knows it can read your notifications and send you fake ones. So the name
# must stay unguessable. Keep a readable prefix for the phone, and append a
# random part for secrecy:
#
#   echo "imc-digest-$(openssl rand -hex 20)"
#
# Keep the prefix; replace only the hex part with your own generated value.
IMC_NTFY_SERVER="https://ntfy.sh"
IMC_NTFY_TOPIC="imc-digest-replace-this-with-40-hex-characters"
IMC_NTFY_TITLE="朝のメール"
IMC_NTFY_PRIORITY="high"
